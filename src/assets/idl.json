        { "name": "uid", "type": "u64", "index": false },
        { "name": "unlockTimestamp", "type": "i64", "index": false }
      ]
    },
    {
      "name": "UnstakeEvt",
      "fields": [
        { "name": "tokenMint", "type": "publicKey", "index": false },
        { "name": "user", "type": "publicKey", "index": false },
        { "name": "amount", "type": "u64", "index": false },
        { "name": "uid", "type": "u64", "index": false }
